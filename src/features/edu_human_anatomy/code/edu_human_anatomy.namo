// NAMO Hot-Swappable Script: Interactive 3D Human Anatomy
// Version: 1.5.0

module edu_human_anatomy {
  export function Initialize() {
    NamoLogger.Log("Initialized 3D Human Anatomy Educational Module");
  }

  export function Load() {
    NamoRegistry.RegisterComponent("edu_human_anatomy");
  }

  export function Unload() {
    NamoRegistry.UnregisterComponent("edu_human_anatomy");
  }
}
