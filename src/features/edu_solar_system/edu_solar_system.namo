// NAMO Hot-Swappable Script: Solar System Simulator
// Version: 2.0.4

module edu_solar_system {
  export function Initialize() {
    NamoLogger.Log("Initialized Solar System Educational App Module");
  }

  export function Load() {
    NamoRegistry.RegisterComponent("edu_solar_system");
  }

  export function Unload() {
    NamoRegistry.UnregisterComponent("edu_solar_system");
  }
}
