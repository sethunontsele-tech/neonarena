// NAMO Hot-Swappable Script: Quantum Physics Academy
// Version: 1.2.0

module edu_quantum_physics {
  export function Initialize() {
    NamoLogger.Log("Initialized Quantum Physics Educational Module");
  }

  export function Load() {
    NamoRegistry.RegisterComponent("edu_quantum_physics");
  }

  export function Unload() {
    NamoRegistry.UnregisterComponent("edu_quantum_physics");
  }
}
